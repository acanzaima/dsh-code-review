# Normalise all text files to LF in the repository so the generated client
# bundle stays byte-identical across Windows, macOS and Linux checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.tgz binary

# Generated by scripts/build.mjs from src/client/*.js — collapsed in GitHub diffs.
client.js linguist-generated=true
